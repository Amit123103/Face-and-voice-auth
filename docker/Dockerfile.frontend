# ═══════════════════════════════════════════
# FaceVoiceAuth — Frontend Dockerfile
# Nginx serving static files with API proxy to backend
# ═══════════════════════════════════════════

FROM nginx:1.25-alpine

# Remove default nginx content
RUN rm -rf /usr/share/nginx/html/*

# Copy frontend files
COPY frontend/ /usr/share/nginx/html/

# Copy nginx configuration template
COPY docker/nginx.conf /etc/nginx/templates/default.conf.template

# Set default environment variables
ENV PORT=80 \
    BACKEND_HOST=backend \
    BACKEND_PORT=8000

# Set correct permissions
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

EXPOSE 80

# Use envsubst to replace variables in the config before starting nginx
CMD ["sh", "-c", "envsubst '${PORT} ${BACKEND_HOST} ${BACKEND_PORT}' < /etc/nginx/templates/default.conf.template > /etc/nginx/conf.d/default.conf && exec nginx -g 'daemon off;'"]
