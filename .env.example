# ═══════════════════════════════════════════
# FaceVoiceAuth — Environment Variables
# Copy to .env and fill in your values
# ═══════════════════════════════════════════

# ── Application ──
APP_NAME=FaceVoiceAuth
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# ── Database ──
# Development (SQLite)
DATABASE_URL=sqlite+aiosqlite:///./facevoiceauth.db
ASYNC_DATABASE_URL=sqlite+aiosqlite:///./facevoiceauth.db
# Production (PostgreSQL)
# DATABASE_URL=postgresql+asyncpg://fva_user:fva_password@localhost:5432/facevoiceauth
# ASYNC_DATABASE_URL=postgresql+asyncpg://fva_user:fva_password@localhost:5432/facevoiceauth
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ── JWT / Auth ──
SECRET_KEY=change-me-to-a-random-64-char-hex-string-in-production-for-maximum-security-now
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Encryption ──
# Generate with: python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
MASTER_KEY=CHANGE_ME_base64_encoded_32_byte_key_here_abcdefghijk=

# ── Face Recognition ──
FACE_MATCH_THRESHOLD=0.45
MIN_FACE_LIVENESS_SCORE=0.75
FACE_MULTI_FRAME_COUNT=3
FACE_MAX_ANGLES=5
FACE_MODEL_DIR=./backend/models_data

# ── Voice Authentication ──
VOICE_MATCH_THRESHOLD=0.82
MIN_VOICE_LIVENESS_SCORE=0.80
VOICE_MIN_SAMPLES=3
VOICE_MAX_SAMPLES=10
VOICE_MIN_DURATION=3.0
VOICE_MAX_DURATION=10.0
VOICE_MIN_SNR=15.0
VOICE_CONSECUTIVE_MATCHES=2

# ── Biometric Fusion ──
FACE_FUSION_WEIGHT=0.6
VOICE_FUSION_WEIGHT=0.4
FUSION_MIN_SCORE=0.80
FUSION_INDIVIDUAL_MIN=0.60

# ── Lockout ──
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_SECONDS=60

# ── CORS ──
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:8080,http://localhost:80

# ── Admin Seed ──
ADMIN_EMAIL=admin@facevoiceauth.local
ADMIN_PASSWORD=ChangeMe!2024Secure

# ── SMTP (for lockout notifications) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# ── Redis (for rate limiting) ──
REDIS_URL=redis://localhost:6379/0

# ── Backup ──
BACKUP_DIR=/data/backups
BACKUP_RETENTION_DAYS=30

# ── Rate Limiting ──
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_FACE_ENROLL=3/minute
RATE_LIMIT_VOICE_ENROLL=3/minute
RATE_LIMIT_GENERAL=100/minute

# ── Sentry (optional) ──
# SENTRY_DSN=https://your-dsn@sentry.io/project-id
